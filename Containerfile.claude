# Container image for running Claude Code in a sandboxed environment
# Optimized for Python (uv) and Node.js development.
# Uses ubuntu:25.10 to provide maximum glibc and build toolchain compatibility.
#
# Build:  podman build -t claude-sandbox -f Containerfile.claude .
# Run:    ./claude-container.sh

FROM ubuntu:25.10

ARG USERNAME=devuser
ENV USERNAME=${USERNAME}

ENV DEBIAN_FRONTEND=noninteractive

# --- System tools and Python build dependencies ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash coreutils findutils procps \
    git git-lfs \
    curl wget \
    jq \
    zip unzip tar gzip \
    ca-certificates gnupg \
    patch diffutils \
    file less \
    sed gawk \
    # Python build dependencies \
    build-essential libssl-dev zlib1g-dev \
    libbz2-dev libreadline-dev libsqlite3-dev \
    libncursesw5-dev xz-utils tk-dev libxml2-dev \
    libxmlsec1-dev libffi-dev liblzma-dev \
    # Base Python just in case \
    python3 python3-pip python-is-python3 \
    && rm -rf /var/lib/apt/lists/*

# --- GitHub CLI ---
RUN curl -fsSL https://cli.github.com/packages/githubcli-archive-keyring.gpg \
      | gpg --dearmor -o /usr/share/keyrings/githubcli-archive-keyring.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/githubcli-archive-keyring.gpg] https://cli.github.com/packages stable main" \
      > /etc/apt/sources.list.d/github-cli.list \
    && apt-get update && apt-get install -y gh \
    && rm -rf /var/lib/apt/lists/*

# --- Playwright browser dependencies ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    libnss3 libnspr4 libatk1.0-0 libatk-bridge2.0-0 \
    libcups2 libdrm2 libxkbcommon0 libxcomposite1 \
    libxdamage1 libxfixes3 libxrandr2 libgbm1 libasound2t64 \
    libpango-1.0-0 libcairo2 libx11-6 libx11-xcb1 libxcb1 \
    libxext6 libxshmfence1 fonts-liberation \
    && rm -rf /var/lib/apt/lists/*

# --- Screenshot, PDF and image tooling ---
# poppler-utils (pdftoppm) and imagemagick let Claude render PDFs and slides
# to PNG and inspect them. The fonts make screenshots of Norwegian text,
# emoji and Kantega decks (Source Sans 3) render correctly.
RUN apt-get update && apt-get install -y --no-install-recommends \
    poppler-utils imagemagick \
    fonts-noto-core fonts-noto-color-emoji fonts-dejavu-core \
    fonts-adobe-sourcesans3 \
    ripgrep fd-find tree \
    postgresql-client \
    && ln -s /usr/bin/fdfind /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# --- LibreOffice (headless, for document conversion) ---
RUN apt-get update && apt-get install -y --no-install-recommends \
    libreoffice-core libreoffice-common \
    libreoffice-writer libreoffice-calc libreoffice-impress \
    && rm -rf /var/lib/apt/lists/*

# --- Node.js 24 LTS ---
RUN curl -fsSL https://deb.nodesource.com/setup_24.x | bash - \
    && apt-get install -y nodejs \
    && rm -rf /var/lib/apt/lists/*

# --- mise (per-project Node versions from .nvmrc, .node-version, mise.toml) ---
# Version and digest pinned. To bump, change MISE_VERSION and both SHA256
# values from the release's SHASUMS256.txt.
RUN MISE_VERSION=2026.9.17 && \
    case "$(dpkg --print-architecture)" in \
      amd64) TARBALL="mise-v${MISE_VERSION}-linux-x64.tar.gz"; \
             SHA256="8d1bcbc0b2ba167ee765e7410502c3f89974d0195eb8ec74537bc93bb367420d" ;; \
      arm64) TARBALL="mise-v${MISE_VERSION}-linux-arm64.tar.gz"; \
             SHA256="46717187f93d4ebfff8b87a30da3f5939af995057c0c1a855e968f0ee4d19c88" ;; \
      *) echo "unsupported arch" >&2; exit 1 ;; \
    esac && \
    curl -fsSL -o /tmp/mise.tgz "https://github.com/jdx/mise/releases/download/v${MISE_VERSION}/${TARBALL}" && \
    echo "${SHA256}  /tmp/mise.tgz" | sha256sum -c - && \
    tar -C /tmp -xzf /tmp/mise.tgz mise/bin/mise && \
    install -m 0755 /tmp/mise/bin/mise /usr/local/bin/mise && \
    rm -rf /tmp/mise /tmp/mise.tgz

COPY setup_user.sh /tmp/setup_user.sh
RUN chmod +x /tmp/setup_user.sh \
    && /tmp/setup_user.sh ${USERNAME} \
    && rm /tmp/setup_user.sh

USER ${USERNAME}
WORKDIR /home/${USERNAME}

# --- Install uv ---
RUN curl -LsSf https://astral.sh/uv/install.sh | env UV_INSTALL_DIR="/home/${USERNAME}/.local/bin" sh
ENV PATH="/home/${USERNAME}/.local/bin:${PATH}"

# --- Node via mise shims ---
# Node 24 is the global default. A project with .nvmrc or .node-version gets
# that version, installed on first use into the claude-mise-data volume.
# Python versions stay with uv, which reads .python-version itself.
ENV MISE_IDIOMATIC_VERSION_FILE_ENABLE_TOOLS=node
ENV MISE_TRUSTED_CONFIG_PATHS=/
ENV PATH="/home/${USERNAME}/.local/share/mise/shims:${PATH}"
RUN mise use -g node@24 && node --version

# --- Lint and hook tools (ruff, pre-commit, markdownlint-cli2) ---
# Installed outside ~/.local/share/uv, which the claude-uv-cache volume
# shadows at runtime. PATH is reset for root so npm does not resolve node
# through the mise shims, which have no version configured for root.
USER root
RUN export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin && \
    UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
      /home/${USERNAME}/.local/bin/uv tool install --python /usr/bin/python3 ruff && \
    UV_TOOL_DIR=/opt/uv-tools UV_TOOL_BIN_DIR=/usr/local/bin \
      /home/${USERNAME}/.local/bin/uv tool install --python /usr/bin/python3 pre-commit && \
    /usr/bin/npm install -g markdownlint-cli2 && \
    ruff --version && pre-commit --version && command -v markdownlint-cli2
USER ${USERNAME}
RUN mkdir -p /home/${USERNAME}/.cache/pre-commit

# --- Playwright browsers for the Playwright MCP plugin and scripts ---
# Google Chrome has no Linux arm64 build, so the MCP must use Playwright's
# bundled Chromium, headless. The browser revision the MCP needs is
# preinstalled here; entrypoint.sh fetches newer revisions into the
# persistent claude-playwright-cache volume when @playwright/mcp updates.
ENV PLAYWRIGHT_MCP_BROWSER=chromium
ENV PLAYWRIGHT_MCP_HEADLESS=true
RUN npx -y @playwright/mcp@latest install-browser chromium

# --- Claude Code ---
USER root
# The native installer (https://claude.ai/install.sh) runs out of memory (OOM Exit 137)
# during the binary extraction phase in Podman on macOS natively.
# We bypass the shell script wrapper entirely and pull the static binary directly.
RUN ARCH=$(dpkg --print-architecture) && \
    if [ "$ARCH" = "amd64" ]; then CLAUDE_ARCH="linux-x64"; else CLAUDE_ARCH="linux-arm64"; fi && \
    VERSION=$(curl -fsSL https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/latest) && \
    curl -fsSL -o /usr/local/bin/claude "https://storage.googleapis.com/claude-code-dist-86c565f3-f756-42ad-8dfa-d59b1c096819/claude-code-releases/${VERSION}/${CLAUDE_ARCH}/claude" && \
    chmod +x /usr/local/bin/claude

# Managed CLAUDE.md: tells Claude inside the sandbox what tools it has.
COPY sandbox-instructions.md /etc/claude-code/CLAUDE.md
USER ${USERNAME}

COPY --chown=${USERNAME}:${USERNAME} entrypoint.sh /home/${USERNAME}/.entrypoint.sh
RUN chmod +x /home/${USERNAME}/.entrypoint.sh

ENTRYPOINT ["/bin/sh", "-c", "exec /home/$USERNAME/.entrypoint.sh \"$@\"", "--"]
